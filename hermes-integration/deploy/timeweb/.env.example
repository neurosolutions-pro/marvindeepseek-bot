# Production secrets for Timeweb Hermes gateway — do not commit.
HERMES_API_KEY=change-me
HERMES_BASE_URL=http://127.0.0.1:8000
HERMES_HOST=0.0.0.0
HERMES_PORT=8000
HERMES_MODEL=deepseek-chat
HERMES_LOG_LEVEL=info
# OpenAI-compatible upstream (DeepSeek by default)
HERMES_UPSTREAM_BASE_URL=https://api.deepseek.com/v1
HERMES_UPSTREAM_API_KEY=
HERMES_TIMEOUT=120
